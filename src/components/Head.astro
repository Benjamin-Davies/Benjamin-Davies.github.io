---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{name}</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap"
  rel="stylesheet"
/>

<link rel="icon" href="favicon.png" />

<!-- Basic SEO -->
<meta
  name="description"
  content="Ben Davies: software engineer, musician and tinkerer based in Christchurch, NZ."
/>
<link rel="canonical" href="https://bend.nz/" />

<!-- Open Graph (Facebook, LinkedIn, Slack, Discord, iMessage, etc.) -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://bend.nz/" />
<meta property="og:title" content="Ben Davies" />
<meta
  property="og:description"
  content="Software engineer, musician and tinkerer."
/>
<meta property="og:image" content="https://bend.nz/og-image.png" />
<meta
  property="og:image:alt"
  content="Terminal-style portfolio page for Ben Davies"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="bend.nz" />
<meta property="og:locale" content="en_NZ" />
