---
interface Props {
  path?: string;
  command: string;
  title?: string;
}

const { path, command, title } = Astro.props;

let firstPart = true;
const commandParts = command.split(" ").map((s) => {
  const part = { s, firstPart };
  firstPart = s === "&&";
  return part;
});
---

{title && <h2 aria-label={title} />}
<p class="mt-4 select-none" aria-hidden>
  <span class="text-cyan">bend@bend.nz:{path ?? "~"}$ </span>
  {
    commandParts.map(({ s, firstPart }) => {
      if (firstPart) {
        return <span class="text-green">{s} </span>;
      } else {
        return s + " ";
      }
    })
  }
</p>
