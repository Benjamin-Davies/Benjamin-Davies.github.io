---
import CommandLine from "../components/CommandLine.astro";
import MainLayout from "../components/MainLayout.astro";
import Awesome from "../components/sections/Awesome.astro";
import Experience from "../components/sections/Experience.astro";

const name = "Ben Davies";
---

<MainLayout {name}>
  <div class="container flex flex-col md:mx-auto md:max-w-240 md:p-4">
    <main class="md:bg-base md:border-border p-2 md:border-[1px]">
      <header>
        <p class="text-text2 select-none" aria-hidden>
          Last login: Thu Apr 7 15:13:13 2005 from 192.168.0.42
        </p>
        <CommandLine command="whoami" />
        <h1 class="text-3xl">Ben Davies</h1>
        <CommandLine command="groups" />
        <h2 class="text-lg">software-engineer musician tinkerer</h2>
        <CommandLine
          command="cat .git-credentials"
          title="Academic Credentials"
        />
        <p>bachelor-of-engineering:hons@canterbury.ac.nz</p>
        <CommandLine command="cat bookmarks.md" title="Links" />
        <ul class="list-hyphen">
          <li>
            <a class="underline" href="https://github.com/Benjamin-Davies"
              >Benjamin-Davies</a
            > on GitHub
          </li>
          <li>
            <a
              class="underline"
              href="https://www.linkedin.com/in/benjamin-davies-657234226"
              >Benjamin Davies</a
            > on LinkedIn
          </li>
          <li>
            Email me at <a
              class="underline"
              href="mailto:bentendavies@gmail.com">bentendavies@gmail.com</a
            >
          </li>
        </ul>
      </header>
      <section>
        <CommandLine command="cd experience/ && jj log" title="Experience" />
        <Experience />
      </section>
      <section>
        <CommandLine
          path="~/experience"
          command="cd ../awesome/ && cat README.md"
          title="Awesome Stuff"
        />
        <Awesome />
      </section>
      <footer>
        <CommandLine path="~/awesome" command="cat ~/.config/colors.cfg" />
        <p>
          Colours from Catppuccin
          <span class="dark:hidden">Late</span>
          <span class="not-dark:hidden">Mocha</span>
        </p>
        <CommandLine path="~/awesome" command="exit" />
      </footer>
    </main>
  </div>
</MainLayout>
